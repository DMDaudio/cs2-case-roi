{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "app/api/cases/route.ts": { "maxDuration": 30 },
    "app/api/cases/[id]/route.ts": { "maxDuration": 30 },
    "app/api/compare/route.ts": { "maxDuration": 30 },
    "app/api/refresh/route.ts": { "maxDuration": 60 },
    "app/api/cron/snapshot/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/snapshot", "schedule": "0 6 * * *" }
  ]
}
